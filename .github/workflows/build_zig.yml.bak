name: Zig Build

on:
  workflow_dispatch:
  push:
    branches:
      - zig
jobs:
  x86_64-windows-gnu-build:
    name: Zig x86_64-windows-gnu Build
    runs-on: windows-2019
    steps:
      - name: Init Env
        run: |
          choco install wget
      - name: Cache zig-bootstrap-release
        id: cache-zig-bootstrap-release
        uses: actions/cache@v4
        with:
          path: prime-numbers
          key: x86_64-windows-gnu-zig-bootstrap-release
      - name: Init zig-bootstrap-release
        if: steps.cache-zig-bootstrap-release.outputs.cache-hit != 'true'
        run: |
          cd C:\ ; wget -q https://github.com/gxiGpf/build/releases/download/dep-files/zig+llvm+lld+clang-x86_64-windows-gnu-0.15.0-dev.233+7c85dc460.zip
          7z x zig+llvm+lld+clang-x86_64-windows-gnu-0.15.0-dev.233+7c85dc460.zip -oC:\ ; rm zig+llvm+lld+clang-x86_64-windows-gnu-0.15.0-dev.233+7c85dc460.zip
          mv zig+llvm+lld+clang-x86_64-windows-gnu-0.15.0-dev.233+7c85dc460 zig-bootstrap-release
      - uses: ilammy/msvc-dev-cmd@v1
        with:
          arch: amd64
      - name: Build
        run: |
          cd C:\ ; git clone --depth 1 https://github.com/ziglang/zig 
          wget -q https://raw.githubusercontent.com/gxiGpf/build/refs/heads/zig/0.patch ; cd zig
          git apply ..\0.patch
          mkdir build ; cd build
          cmake .. -GNinja -DCMAKE_PREFIX_PATH="C:\zig-bootstrap-release" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=C:\zig-release -DZIG_STATIC=ON -DZIG_AR_WORKAROUND=ON `
            -DZIG_TARGET_TRIPLE="x86_64-windows-gnu" -DZIG_TARGET_MCPU="skylake" `
            -DCMAKE_C_COMPILER="C:\zig-bootstrap-release\bin\zig.exe;cc;-target;x86_64-windows-gnu;-mcpu=skylake" `
            -DCMAKE_CXX_COMPILER="C:\zig-bootstrap-release\bin\zig.exe;c++;-target;x86_64-windows-gnu;-mcpu=skylake" `
            -DCMAKE_AR="C:\zig-bootstrap-release\bin\zig.exe"
          ninja install
          cd C:\zig-release\bin
          wget -q https://raw.githubusercontent.com/gxiGpf/build/refs/heads/zig/bin/zig-c++.cmd
          wget -q https://raw.githubusercontent.com/gxiGpf/build/refs/heads/zig/bin/zig-cc.cmd
      - name: Pack
        run: |
          7z a C:\zig-custom-x86_64-windows-gnu-master-release.7z C:\zig-release
      - name: Update Zig Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: zig-build
          files: |
            C:\zig-custom-x86_64-windows-gnu-master-release.7z
